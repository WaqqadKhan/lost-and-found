generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String?
  password      String
  role          String         @default("user")
  autoApprove   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  items         Item[]
  notifications Notification[]
  claims        Claim[]
  comments      Comment[]
  successStories SuccessStory[]
  reunionViews  ReunionView[]

  @@index([role])
}

model Item {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  location    String
  date        DateTime
  type        String
  status      String   @default("pending")
  image       String?
  images      String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  verificationQuestion String?
  verificationAnswer   String?
  claims      Claim[]
  comments    Comment[]
  successStories SuccessStory[]
  reunionViews ReunionView[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([type, status])
  @@index([createdAt])
  @@index([userId])
  @@index([category])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  type      String
  itemId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Claim {
  id                 String   @id @default(cuid())
  itemId             String
  item               Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimantId         String
  claimant           User     @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  message            String
  status             String   @default("pending")
  verificationAnswer String?
  verificationMatched Boolean @default(false)
  createdAt          DateTime @default(now())

  @@unique([itemId, claimantId])
}

model Comment {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model SuccessStory {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?
  createdAt DateTime @default(now())

  @@unique([itemId, userId])
}

model ReunionView {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([itemId, userId])
}

/// Singleton site-wide appearance (id = "default"). Controlled by admin; applies to all users.
model SiteSettings {
  id             String   @id @default("default")
  canvasMode     String   @default("solid")
  canvasColor1   String   @default("#F4F1E8")
  canvasColor2   String   @default("#E4EDE4")
  canvasColor3   String?
  gradientAngle  Int      @default(145)
  updatedAt      DateTime @updatedAt
}
